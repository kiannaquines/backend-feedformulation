# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_NAME="Feed Formulation API"
APP_VERSION="1.0.0"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
ENVIRONMENT=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_PATH=app_database.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For SQLite (default): sqlite:///./app_database.db

# ==========================================
# JWT & SECURITY SETTINGS
# ==========================================
# IMPORTANT: Generate a secure secret key using: openssl rand -hex 32
# DO NOT use this example key in production!
JWT_SECRET_KEY=your-secret-key-here-generate-using-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==========================================
# OTP CONFIGURATION
# ==========================================
OTP_IS_ENABLED=False
OTP_SESSION_EXPIRATION_MINUTES=10
OTP_MAX_DIGIT=6
OTP_INTERVAL_SECONDS=60

# ==========================================
# EMAIL/SMTP CONFIGURATION
# ==========================================
# For Gmail: 
# 1. Enable 2-factor authentication
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Feed Formulation System

# ==========================================
# AI SERVICE CONFIGURATION
# ==========================================
# Groq AI (PRIMARY — ultra-fast LLaMA inference for ingredient suggestions)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Google AI (Gemini) — Optional fallback if Groq is unavailable
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# AI Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
