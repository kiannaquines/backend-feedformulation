# Email Configuration for OTP Delivery
# Configure these settings to enable email sending for OTP codes

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email Account Credentials
# For Gmail: Use an App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=qgqy azhp ihml himx

# Sender Information
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Feed Formulation System

# How to set up Gmail for sending emails:
# 1. Go to your Google Account settings
# 2. Navigate to Security > 2-Step Verification
# 3. Enable 2-Step Verification if not already enabled
# 4. Go to Security > App passwords
# 5. Generate a new app password for "Mail"
# 6. Copy the 16-character password and use it as SMTP_PASSWORD

# Alternative email providers:
# - Outlook/Hotmail: smtp.office365.com (port 587)
# - Yahoo: smtp.mail.yahoo.com (port 587)
# - SendGrid: smtp.sendgrid.net (port 587)
# - Amazon SES: Check AWS documentation
